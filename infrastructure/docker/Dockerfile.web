# syntax=docker/dockerfile:1.7
FROM node:24.21.0-bookworm-slim AS build
WORKDIR /workspace
RUN npm install --global --allow-scripts=pnpm pnpm@12.10.1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api-gateway/package.json apps/api-gateway/package.json
COPY apps/indexer-service/package.json apps/indexer-service/package.json
COPY apps/portfolio-service/package.json apps/portfolio-service/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/blockchain-client/package.json packages/blockchain-client/package.json
COPY packages/messaging/package.json packages/messaging/package.json
COPY packages/observability/package.json packages/observability/package.json
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm install --frozen-lockfile --store-dir=/pnpm/store
COPY packages/ packages/
COPY apps/web/ apps/web/
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG SECURITY_HSTS_ENABLED=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL SECURITY_HSTS_ENABLED=$SECURITY_HSTS_ENABLED NEXT_TELEMETRY_DISABLED=1 WEB_STANDALONE=true
RUN node -e "for(const [key,protocols] of [['NEXT_PUBLIC_API_URL',['http:','https:']],['NEXT_PUBLIC_WS_URL',['ws:','wss:']]]){const value=new URL(process.env[key]);if(!protocols.includes(value.protocol)||value.username||value.password)throw Error('Invalid public build URL')}"
RUN pnpm build:packages && pnpm --dir apps/web build

FROM node:24.21.0-bookworm-slim AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3003
WORKDIR /app
COPY --from=build --chown=node:node /workspace/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /workspace/apps/web/public ./apps/web/public
USER node
EXPOSE 3003
HEALTHCHECK --interval=10s --timeout=4s --start-period=20s --retries=6 CMD ["node", "-e", "fetch('http://127.0.0.1:3003/',{signal:AbortSignal.timeout(3000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "apps/web/server.js"]
