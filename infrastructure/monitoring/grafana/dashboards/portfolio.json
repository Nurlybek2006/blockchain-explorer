      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Price refresh outcome counters.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(portfolio_price_refresh_total{service_name=~\"$service\", status=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} success"
        },
        {
          "refId": "B",
          "expr": "sum by (service_name) (rate(portfolio_price_refresh_errors_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} failed"
        },
        {
          "refId": "C",
          "expr": "sum by (service_name) (rate(portfolio_price_refresh_total{service_name=~\"$service\", status=\"unavailable\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} unavailable"
