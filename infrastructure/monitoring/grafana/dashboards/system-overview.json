      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Known queue and job labels only.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(bullmq_jobs_completed_total{service_name=~\"$service\"}[$__rate_interval]))",
