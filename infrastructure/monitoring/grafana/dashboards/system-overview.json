    {
      "title": "RabbitMQ application publish / consume",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Application counters are separate from broker metrics.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(rabbitmq_published_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (service_name) (rate(rabbitmq_consumed_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} consumed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
