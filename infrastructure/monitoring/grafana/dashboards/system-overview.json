    {
      "title": "BullMQ waiting / active",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Periodic bounded queue counts; no per-scrape Redis scan.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, queue) (bullmq_jobs_waiting{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}} {{queue}} waiting"
        },
        {
          "refId": "B",
          "expr": "sum by (service_name, queue) (bullmq_jobs_active{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}} {{queue}} active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
