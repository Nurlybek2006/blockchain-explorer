    {
      "title": "RabbitMQ broker ready / unacknowledged messages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Native RabbitMQ Prometheus plugin broker metrics.",
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_ready",
          "legendFormat": "{{service_name}}"
        },
        {
          "refId": "B",
          "expr": "rabbitmq_queue_messages_unacked",
          "legendFormat": "unacknowledged"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
