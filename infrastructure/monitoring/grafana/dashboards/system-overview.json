    {
      "title": "Redis cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Redis cache hit ratio",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(cache_hits_total{service_name=~\"$service\"}[$__rate_interval])) / clamp_min(sum by (service_name) (rate(cache_requests_total{service_name=~\"$service\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
