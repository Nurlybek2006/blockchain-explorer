      "title": "Latest RPC block",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Unknown RPC heads are absent; no stale last-success or false zero.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service_name) (indexer_rpc_latest_block{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
