# Copy to ignored .env.production. Generate distinct random secrets (see operations docs).
# Passwords below are embedded in connection URLs: use URL-safe hexadecimal values.
# No PostgreSQL, Redis, RabbitMQ or internal service ports are published.
IMAGE_TAG=local
PROD_BIND_ADDRESS=127.0.0.1
PROD_API_PORT=3000
PROD_WEB_PORT=3003
POSTGRES_USER=blockchain_admin
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
EXPLORER_DB_PASSWORD=
PORTFOLIO_DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
INTERNAL_SERVICE_TOKEN=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Browser addresses are embedded at WEB IMAGE BUILD time; changing them requires rebuild.
WEB_ORIGIN=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000/realtime
# Only enable after HTTPS termination is configured by the deployment environment.
SECURITY_HSTS_ENABLED=false

# Configure a real provider for normal scanning; no provider key is required by tests.
ETHEREUM_RPC_URL=
ETHEREUM_CHAIN_ID=11155111
INDEXER_ENABLED=true
INDEXER_START_BLOCK=latest
INDEXER_CONFIRMATIONS=2
INDEXER_BATCH_SIZE=5
INDEXER_POLL_INTERVAL_MS=12000
INDEXER_ERROR_BACKOFF_MS=5000
INDEXER_RECEIPT_CONCURRENCY=8
INDEXER_REORG_MAX_DEPTH=64
RPC_TIMEOUT_MS=15000
RPC_MAX_RETRIES=6
RPC_RETRY_BASE_DELAY_MS=500
RPC_MAX_RETRY_DELAY_MS=30000
RPC_MAX_CONCURRENT_REQUESTS=3
RPC_REQUESTS_PER_SECOND=5
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_PROCESSING_TIMEOUT_MS=60000
OUTBOX_MAX_RETRY_DELAY_MS=60000
RABBITMQ_PREFETCH=20
PORTFOLIO_WORKER_CONCURRENCY=5
PORTFOLIO_HTTP_TIMEOUT_MS=10000

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_API_KEY_TYPE=demo
COINGECKO_TIMEOUT_MS=10000
COINGECKO_MAX_RETRIES=4
COINGECKO_MAX_CONCURRENT_REQUESTS=2
COINGECKO_REQUESTS_PER_SECOND=0.3
PRICE_SCHEDULER_ENABLED=true
PRICE_REFRESH_INTERVAL_MS=60000
PORTFOLIO_SNAPSHOT_INTERVAL_MS=300000
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=
ETHERSCAN_TIMEOUT_MS=10000
ETHERSCAN_MAX_RETRIES=4
ETHERSCAN_REQUESTS_PER_SECOND=2
CONTRACT_VERIFICATION_ENABLED=true
CONTRACT_VERIFICATION_COOLDOWN_MS=86400000
CONTRACT_VERIFICATION_MAX_LOOKUPS=3
EXPLORER_ENRICHMENT_ENABLED=true
TRACE_ENABLED=true
TRACE_ONLY_CONTRACT_INTERACTIONS=true
TRACE_WORKER_CONCURRENCY=1
TRACE_MAX_RETRIES=3
TRACE_TIMEOUT_MS=15000
NETWORK_STATUS_INTERVAL_MS=15000
NETWORK_STATUS_TIMEOUT_MS=2500
REALTIME_ENABLED=true
REALTIME_MAX_CLIENTS=500

# API abuse settings are shared across Gateway replicas in Redis.
API_BODY_LIMIT_BYTES=65536
API_RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SEARCH_MAX=120
RATE_LIMIT_EXPENSIVE_MAX=60
RATE_LIMIT_REDIS_TIMEOUT_MS=250
TRUST_PROXY=false

# Optional production observability overlay. Enable OTEL when starting that overlay.
NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production
LOG_FORMAT=json
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SAMPLE_RATIO=0.1
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
PROD_GRAFANA_PORT=3004
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
