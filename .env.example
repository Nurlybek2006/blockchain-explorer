# PostgreSQL
POSTGRES_USER=blockchain
POSTGRES_PASSWORD='change_me'
POSTGRES_DB=postgres
POSTGRES_PORT=5432

IDENTITY_DATABASE_URL=postgresql://blockchain:change_me@localhost:5432/identity_db

EXPLORER_DATABASE_URL=postgresql://blockchain:change_me@localhost:5432/explorer_db

PORTFOLIO_DATABASE_URL=postgresql://blockchain:change_me@localhost:5432/portfolio_db

# PostgreSQL pool
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# ============================================
# Ethereum JSON-RPC
# ============================================

ETHEREUM_RPC_URL=https://YOUR_SEPOLIA_RPC_URL
ETHEREUM_CHAIN_ID=11155111
RPC_TIMEOUT_MS=15000
RPC_MAX_RETRIES=3
RPC_RETRY_BASE_DELAY_MS=500


# ============================================
# Indexer
# ============================================

INDEXER_ENABLED=true
INDEXER_START_BLOCK=latest
INDEXER_CONFIRMATIONS=2
INDEXER_BATCH_SIZE=5
INDEXER_POLL_INTERVAL_MS=12000
INDEXER_ERROR_BACKOFF_MS=5000
INDEXER_RECEIPT_CONCURRENCY=8
INDEXER_CHECKPOINT_INTERVAL=100
INDEXER_REORG_MAX_DEPTH=64

API_GATEWAY_PORT=3000
INDEXER_PORT=3001
PORTFOLIO_PORT=3002
WEB_PORT=3003
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# Ethereum RPC protection
# ============================================

RPC_TIMEOUT_MS=15000
RPC_MAX_RETRIES=6
RPC_RETRY_BASE_DELAY_MS=500
RPC_MAX_RETRY_DELAY_MS=30000
RPC_MAX_CONCURRENT_REQUESTS=3
RPC_REQUESTS_PER_SECOND=5

# ============================================
# Internal microservice communication
# ============================================

INDEXER_INTERNAL_URL=http://localhost:3001
PORTFOLIO_INTERNAL_URL=http://localhost:3002
PORTFOLIO_HTTP_TIMEOUT_MS=10000
INTERNAL_SERVICE_TOKEN=change_this_to_a_long_random_secret
WEB_ORIGIN=http://localhost:3003

# ============================================
# Redis
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

CACHE_PREFIX=blockchain-explorer
CACHE_STATS_TTL_SECONDS=5
CACHE_LIST_TTL_SECONDS=10
CACHE_DETAIL_TTL_SECONDS=60


# ============================================
# RabbitMQ
# ============================================

RABBITMQ_USER=blockchain
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=blockchain

RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

RABBITMQ_URL=amqp://blockchain:change_me@localhost:5672/blockchain

RABBITMQ_EXCHANGE=blockchain.events

RABBITMQ_PREFETCH=20


# ============================================
# Transactional Outbox
# ============================================

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_PROCESSING_TIMEOUT_MS=60000
OUTBOX_MAX_RETRY_DELAY_MS=60000


# ============================================
# BullMQ
# ============================================

PORTFOLIO_QUEUE_NAME=portfolio-jobs
PORTFOLIO_WORKER_CONCURRENCY=5

# ============================================
# Authentication (distinct random secrets, at least 32 bytes each)
# ============================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ============================================
# Portfolio intelligence / CoinGecko
# ============================================
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
COINGECKO_API_KEY_TYPE=demo
COINGECKO_TIMEOUT_MS=10000
COINGECKO_MAX_RETRIES=4
COINGECKO_RETRY_BASE_DELAY_MS=500
COINGECKO_MAX_RETRY_DELAY_MS=60000
COINGECKO_MAX_CONCURRENT_REQUESTS=2
COINGECKO_REQUESTS_PER_SECOND=0.3
PRICE_CACHE_TTL_SECONDS=30
PRICE_UNAVAILABLE_CACHE_TTL_SECONDS=30
PRICE_STALE_AFTER_SECONDS=300
PRICE_CACHE_TIMEOUT_MS=750
PRICE_REFRESH_INTERVAL_MS=60000
PORTFOLIO_SNAPSHOT_INTERVAL_MS=300000
PRICE_SCHEDULER_ENABLED=true
WHALE_DEFAULT_THRESHOLD_USD=100000
PORTFOLIO_EVENTS_QUEUE=portfolio.events

# Advanced Explorer: Etherscan V2 source/ABI lookup (key optional; blank = unsupported)
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api
ETHERSCAN_API_KEY=
ETHERSCAN_CHAIN_ID=11155111
ETHERSCAN_TIMEOUT_MS=10000
ETHERSCAN_MAX_RETRIES=4
ETHERSCAN_REQUESTS_PER_SECOND=2
CONTRACT_VERIFICATION_ENABLED=true
CONTRACT_VERIFICATION_COOLDOWN_MS=86400000
CONTRACT_VERIFICATION_MAX_LOOKUPS=3
EXPLORER_ENRICHMENT_ENABLED=true
EXPLORER_JOBS_QUEUE_PREFIX=explorer
TRACE_ENABLED=true
TRACE_ONLY_CONTRACT_INTERACTIONS=true
TRACE_WORKER_CONCURRENCY=1
TRACE_MAX_RETRIES=3
TRACE_TIMEOUT_MS=15000
NETWORK_STATUS_INTERVAL_MS=15000
NETWORK_STATUS_TIMEOUT_MS=2500
REALTIME_ENABLED=true
REALTIME_EVENTS_QUEUE=explorer.realtime
REALTIME_MAX_CLIENTS=500
NEXT_PUBLIC_WS_URL=ws://localhost:3000/realtime

# PHASE 11: local OpenTelemetry and monitoring
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SAMPLE_RATIO=1
OTEL_METRIC_EXPORT_INTERVAL_MS=5000
DEPLOYMENT_ENVIRONMENT=development
LOG_FORMAT=pretty
LOG_LEVEL=info
GRAFANA_PORT=3004
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
RABBITMQ_PROMETHEUS_PORT=15692
