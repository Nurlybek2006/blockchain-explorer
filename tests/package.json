{
  "name": "@blockchain-explorer/system-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.helpers.json",
    "test": "vitest run",
    "test:integration": "vitest run integration",
    "test:contracts": "vitest run --config vitest.contracts.config.ts",
    "test:e2e": "vitest run e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blockchain-explorer/blockchain-client": "workspace:*",
    "@blockchain-explorer/contracts": "workspace:*",
    "@blockchain-explorer/messaging": "workspace:*",
    "@blockchain-explorer/observability": "workspace:*",
    "@nestjs/config": "^12.0.1",
    "amqplib": "^0.10.0",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "redis": "^5.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "testcontainers": "11.14.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
