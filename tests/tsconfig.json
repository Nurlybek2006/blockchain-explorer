{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "paths": { "@/*": ["../apps/web/src/*"] },
    "types": ["node", "vitest"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
